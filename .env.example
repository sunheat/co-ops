# Copy to .env and fill in the providers you use. Never commit real keys.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- Gemini (OpenAI-compatible endpoint) ---
GEMINI_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Local (Ollama / LM Studio / vLLM, no key needed) ---
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# --- Optional: shared client settings / example scripts ---
LLM_TIMEOUT=60
LLM_PROVIDER=local
LLM_MODEL=qwen2.5
